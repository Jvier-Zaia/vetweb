<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vet.Web Pet Shop & Veterinaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VetWeb.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
        }
        .navbar-custom .navbar-brand {
            font-size: 1.35rem;
            color: #ffffff !important;
            font-weight: 700;
        }
        .navbar-custom .nav-link {
            color: #f5f3ff !important;
            font-weight: 600;
            font-size: 1.02rem;
            padding: 0.6rem 1.1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
            background-color: rgba(255, 255, 255, 0.2);
            color: #ffffff !important;
        }
        .card-custom {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }
        .card-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 20px -3px rgba(0,0,0,0.08);
        }
        .alias-box {
            background: #faf5ff;
            border: 2px dashed #7c3aed;
            border-radius: 12px;
            padding: 1rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-custom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Tienda" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill text-warning fs-3"></i>
                    <span>Vet.Web</span>
                    <span class="badge bg-warning text-dark fs-6 fw-bold px-2 py-0.5 rounded-pill ms-1">Tienda & Turnos</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navPrincipal">
                    <ul class="navbar-nav mx-auto gap-2 py-2 py-md-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tienda" ? "active" : "")" 
                               asp-controller="Tienda" asp-action="Index">
                                <i class="bi bi-shop me-1 fs-5"></i> Tienda
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Turnos" ? "active" : "")" 
                               asp-controller="Turnos" asp-action="Index">
                                <i class="bi bi-calendar2-check me-1 fs-5"></i> Gestión de Turnos
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Botón para abrir el Carrito Lateral -->
                        <button class="btn btn-warning fw-bold text-dark rounded-pill px-3 py-1 shadow-sm d-flex align-items-center" 
                                type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" aria-controls="cartOffcanvas">
                            <i class="bi bi-cart3 fs-5 me-1"></i>
                            <span>Carrito</span>
                            <span id="cartCountBadge" class="badge bg-danger rounded-pill ms-2">0</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <!-- Notificaciones de éxito o error -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center rounded-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Tarjeta de confirmación de email enviado al dueño -->
        @if (TempData["EmailEnviadoA"] != null)
        {
            <div class="card border-0 border-start border-4 border-info shadow-sm mb-4 bg-white rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-info text-dark fw-bold">
                            <i class="bi bi-envelope-check-fill me-1"></i> Notificación Enviada por Correo Electrónico
                        </span>
                        <small class="text-muted">Servicio SMTP Vet.Web</small>
                    </div>
                    <h6 class="mb-1 fw-bold text-dark">Para: @TempData["EmailDestinatario"] &lt;@TempData["EmailEnviadoA"]&gt;</h6>
                    <p class="mb-0 text-secondary small">
                        <strong>Detalle de la Operación:</strong> @TempData["EmailDetalle"]
                    </p>
                </div>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- OFFCANVAS: CARRITO LATERAL DESLIZABLE -->
    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel" style="width: 420px;">
        <div class="offcanvas-header bg-light border-bottom py-3">
            <h5 class="offcanvas-title fw-bold text-dark d-flex align-items-center" id="cartOffcanvasLabel">
                <i class="bi bi-cart3 me-2 fs-4" style="color: #7c3aed;"></i> Tu Carrito de Compras
            </h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <div id="cartItemsContainer" class="flex-grow-1 overflow-auto">
                <!-- Se rellena con JS dinámicamente -->
            </div>

            <div id="cartFooterSection" class="border-top pt-3 mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span id="cartSubtotalText" class="fw-semibold text-dark">$0</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold fs-5 text-dark">Total a Pagar:</span>
                    <span id="cartTotalText" class="fw-bold fs-4 text-success">$0</span>
                </div>
                <button class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center" 
                        style="background-color: #7c3aed; border-color: #7c3aed;"
                        onclick="abrirCheckoutModal()">
                    <i class="bi bi-wallet2 me-2 fs-5"></i> Iniciar Compra / Pagar con Alias
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: CHECKOUT Y PAGO POR ALIAS CON VERIFICACIÓN -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);">
                    <div>
                        <span class="badge bg-warning text-dark fw-bold mb-1">Paso Final de Compra</span>
                        <h4 class="modal-title fw-bold mb-0" id="checkoutModalLabel">Pago por Transferencia con Alias</h4>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Tienda" asp-action="ProcesarPedido" method="post" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <input type="hidden" name="CarritoJson" id="checkoutCarritoJson" value="[]" />

                        <div class="row g-4">
                            <!-- Columna Izquierda: Datos del Alias y Transferencia -->
                            <div class="col-md-6 border-end">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bank2 me-1" style="color: #7c3aed;"></i> Datos de Transferencia</h6>
                                
                                <div class="alias-box mb-3">
                                    <small class="text-muted fw-bold d-block text-uppercase">Alias Bancario Oficial:</small>
                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                        <span class="fs-4 fw-bold" style="color: #7c3aed;" id="aliasTexto">vetweb.oficial</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold" style="border-color: #7c3aed; color: #7c3aed;" onclick="copiarAlias()">
                                            <i class="bi bi-clipboard me-1"></i> Copiar
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-2">CBU: <strong>0000003100098456214589</strong></small>
                                    <small class="text-muted d-block">Titular: <strong>Vet.Web Clínica & Pet Shop</strong></small>
                                </div>

                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Monto Exacto a Transferir:</span>
                                        <span id="checkoutMontoTotal" class="fs-4 fw-bold" style="color: #7c3aed;">$0</span>
                                    </div>
                                    <small class="text-muted d-block mt-1">Transferible desde Mercado Pago, Ualá o cualquier banco.</small>
                                </div>

                                <div class="alert alert-info mt-3 p-2 small d-flex align-items-center rounded-3">
                                    <i class="bi bi-robot fs-4 me-2 text-primary"></i>
                                    <div><strong>Asistente Activo:</strong> El sistema validará tu comprobante y confirmará el stock en MariaDB automáticamente.</div>
                                </div>
                            </div>

                            <!-- Columna Derecha: Formulario del Comprador y Comprobante -->
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person-check me-1" style="color: #7c3aed;"></i> Tus Datos de Contacto</h6>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Nombre y Apellido (*)</label>
                                    <input type="text" name="ClienteNombre" class="form-control" placeholder="Ej: Carlos Gómez" required />
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold">Teléfono (*)</label>
                                        <input type="tel" name="ClienteTelefono" class="form-control" placeholder="Ej: 11-4455-6677" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold">Correo Electrónico (*)</label>
                                        <input type="email" name="ClienteEmail" class="form-control" placeholder="nombre@mail.com" required />
                                    </div>
                                </div>

                                <hr class="my-3 text-muted" />

                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-receipt me-1" style="color: #7c3aed;"></i> Comprobante de Pago</h6>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Adjuntar Foto o Captura de Transferencia</label>
                                    <input type="file" name="Comprobante" class="form-control" accept="image/*,.pdf" />
                                    <span class="form-text small text-muted">Formatos: JPG, PNG, PDF o captura de pantalla.</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Nro. de Operación / Transacción <span class="text-muted fw-normal">(opcional)</span></label>
                                    <input type="text" name="NroOperacion" class="form-control" placeholder="Ej: 849201" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light p-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Seguir Comprando</button>
                        <button type="submit" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" style="background-color: #7c3aed; border-color: #7c3aed;">
                            <i class="bi bi-check2-circle me-1"></i> Enviar y Verificar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TOAST DE NOTIFICACIÓN DE PRODUCTO AGREGADO -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div id="cartToast" class="toast align-items-center text-white border-0 shadow-lg rounded-3" style="background-color: #7c3aed;" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center">
                    <i class="bi bi-cart-check-fill fs-4 me-2 text-warning"></i>
                    <span id="toastMessage">¡Producto agregado al carrito!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted py-3 bg-white mt-auto">
        <div class="container text-center small">
            <strong>Vet.Web</strong> &bull; Tienda Pet Shop & Gestión de Turnos &bull; ASP.NET Core &bull; MariaDB Local &bull; &copy; 2026
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- MOTOR DEL CARRITO DE COMPRAS (JS) -->
    <script>
        const CART_STORAGE_KEY = 'vetweb_shopping_cart';

        function getCart() {
            try {
                return JSON.parse(localStorage.getItem(CART_STORAGE_KEY)) || [];
            } catch {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
            updateCartUI();
        }

        function addToCart(id, nombre, precio, stock) {
            let cart = getCart();
            let item = cart.find(x => x.id === id);

            if (item) {
                if (item.cantidad < stock) {
                    item.cantidad += 1;
                    showToast(`Agregaste otra unidad de "${nombre}" al carrito.`);
                } else {
                    showToast(`No hay más stock disponible de "${nombre}".`);
                    return;
                }
            } else {
                cart.push({ id, nombre, precio, cantidad: 1, stockMax: stock });
                showToast(`¡"${nombre}" agregado al carrito!`);
            }

            saveCart(cart);
        }

        function updateQuantity(id, delta) {
            let cart = getCart();
            let item = cart.find(x => x.id === id);
            if (!item) return;

            item.cantidad += delta;
            if (item.cantidad <= 0) {
                cart = cart.filter(x => x.id !== id);
            } else if (item.cantidad > item.stockMax) {
                item.cantidad = item.stockMax;
                showToast(`Alcanzaste el stock máximo (${item.stockMax} unidades).`);
            }

            saveCart(cart);
        }

        function removeFromCart(id) {
            let cart = getCart().filter(x => x.id !== id);
            saveCart(cart);
        }

        function clearCart() {
            localStorage.removeItem(CART_STORAGE_KEY);
            updateCartUI();
        }

        function updateCartUI() {
            const cart = getCart();
            const countBadge = document.getElementById('cartCountBadge');
            const container = document.getElementById('cartItemsContainer');
            const subtotalText = document.getElementById('cartSubtotalText');
            const totalText = document.getElementById('cartTotalText');
            const footerSection = document.getElementById('cartFooterSection');

            // Actualizar contador del badge
            const totalCount = cart.reduce((acc, curr) => acc + curr.cantidad, 0);
            if (countBadge) countBadge.textContent = totalCount;

            // Renderizar items del carrito
            if (!container) return;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5">
                        <i class="bi bi-cart-x text-muted fs-1 d-block mb-3"></i>
                        <h6 class="text-secondary fw-bold">Tu carrito está vacío</h6>
                        <p class="text-muted small">Explora la tienda y agrega alimentos o accesorios de Pet Shop.</p>
                    </div>`;
                if (footerSection) footerSection.style.display = 'none';
            } else {
                if (footerSection) footerSection.style.display = 'block';

                let total = 0;
                let html = '<div class="list-group list-group-flush">';

                cart.forEach(item => {
                    const subtotal = item.precio * item.cantidad;
                    total += subtotal;
                    html += `
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-2 border-bottom">
                            <div class="flex-grow-1 pe-2">
                                <h6 class="mb-0 fw-bold text-dark">${item.nombre}</h6>
                                <small class="text-muted d-block">$${item.precio.toLocaleString('es-AR')} c/u</small>
                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <button class="btn btn-sm btn-light border py-0 px-2 fw-bold" onclick="updateQuantity(${item.id}, -1)">-</button>
                                    <span class="fw-bold px-1">${item.cantidad}</span>
                                    <button class="btn btn-sm btn-light border py-0 px-2 fw-bold" onclick="updateQuantity(${item.id}, 1)">+</button>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="d-block fw-bold text-success">$${subtotal.toLocaleString('es-AR')}</span>
                                <button class="btn btn-sm btn-link text-danger text-decoration-none p-0 mt-1" onclick="removeFromCart(${item.id})">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>`;
                });

                html += '</div>';
                container.innerHTML = html;

                if (subtotalText) subtotalText.textContent = `$${total.toLocaleString('es-AR')}`;
                if (totalText) totalText.textContent = `$${total.toLocaleString('es-AR')}`;
            }
        }

        function abrirCheckoutModal() {
            const cart = getCart();
            if (cart.length === 0) {
                alert('Agrega al menos un producto a tu carrito para continuar.');
                return;
            }

            const total = cart.reduce((acc, curr) => acc + (curr.precio * curr.cantidad), 0);
            document.getElementById('checkoutMontoTotal').textContent = `$${total.toLocaleString('es-AR')}`;
            document.getElementById('checkoutCarritoJson').value = JSON.stringify(cart);

            // Cerrar el offcanvas y abrir el modal
            const offcanvasEl = document.getElementById('cartOffcanvas');
            const offcanvasInstance = bootstrap.Offcanvas.getInstance(offcanvasEl);
            if (offcanvasInstance) offcanvasInstance.hide();

            const modal = new bootstrap.Modal(document.getElementById('checkoutModal'));
            modal.show();
        }

        function copiarAlias() {
            const alias = document.getElementById('aliasTexto').textContent;
            navigator.clipboard.writeText(alias).then(() => {
                showToast(`¡Alias "${alias}" copiado al portapapeles!`);
            });
        }

        function showToast(message) {
            const toastEl = document.getElementById('cartToast');
            document.getElementById('toastMessage').textContent = message;
            const toast = new bootstrap.Toast(toastEl, { delay: 2800 });
            toast.show();
        }

        // Al cargar la página
        document.addEventListener('DOMContentLoaded', () => {
            // Si venimos de un checkout exitoso, limpiar el carrito
            @if (TempData["LimpiarCarrito"]?.ToString() == "true")
            {
                <text>clearCart();</text>
            }
            updateCartUI();
        });
    </script>

    <!-- ================= VETBOT AI CHAT WIDGET ================= -->
    <style>
        .vetbot-floating-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1045;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
            color: white;
            border: none;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .vetbot-floating-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 10px 28px rgba(124, 58, 237, 0.55);
            color: #f3e8ff;
        }
        .vetbot-pulse-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 14px;
            height: 14px;
            background-color: #10b981;
            border: 2px solid white;
            border-radius: 50%;
        }
        .vetbot-callout {
            position: fixed;
            bottom: 34px;
            right: 94px;
            z-index: 1040;
            background: white;
            color: #1e293b;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border: 1px solid #e2e8f0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .vetbot-window {
            position: fixed;
            bottom: 96px;
            right: 24px;
            z-index: 1050;
            width: 380px;
            max-width: calc(100vw - 32px);
            height: 540px;
            max-height: calc(100vh - 120px);
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
            border: 1px solid #e2e8f0;
            display: none;
            flex-direction: column;
            overflow: hidden;
            animation: vetbotSlideUp 0.25s ease-out forwards;
        }
        @@keyframes vetbotSlideUp {
            from { opacity: 0; transform: translateY(20px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .vetbot-header {
            background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
            color: white;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .vetbot-messages {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .vetbot-msg {
            max-width: 84%;
            padding: 10px 14px;
            font-size: 0.88rem;
            line-height: 1.45;
            word-break: break-word;
        }
        .vetbot-msg-bot {
            background: white;
            color: #1e293b;
            border-radius: 16px 16px 16px 4px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            align-self: flex-start;
        }
        .vetbot-msg-user {
            background: #7c3aed;
            color: white;
            border-radius: 16px 16px 4px 16px;
            align-self: flex-end;
            box-shadow: 0 2px 6px rgba(124, 58, 237, 0.25);
        }
        .vetbot-chip {
            font-size: 0.76rem;
            background: #f3e8ff;
            color: #7c3aed;
            border: 1px solid #ddd6fe;
            border-radius: 50px;
            padding: 4px 10px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 500;
            display: inline-block;
            margin: 2px;
        }
        .vetbot-chip:hover {
            background: #7c3aed;
            color: white;
        }
        .vetbot-typing {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 10px 14px;
        }
        .vetbot-dot {
            width: 6px;
            height: 6px;
            background: #94a3b8;
            border-radius: 50%;
            animation: vetbotBounce 1.4s infinite ease-in-out both;
        }
        .vetbot-dot:nth-child(1) { animation-delay: -0.32s; }
        .vetbot-dot:nth-child(2) { animation-delay: -0.16s; }
        @@keyframes vetbotBounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }
        .vetbot-footer {
            padding: 10px 14px;
            background: white;
            border-top: 1px solid #e2e8f0;
        }
    </style>

    <div id="vetbotCallout" class="vetbot-callout d-none d-md-block">
        <i class="bi bi-stars text-warning me-1"></i> ¿Dudas sobre tu mascota? Chateá con VetBot
    </div>

    <button id="vetbotToggleBtn" class="vetbot-floating-btn" onclick="toggleVetBot()" title="Consultar a VetBot (IA Asistente)">
        <span class="vetbot-pulse-badge"></span>
        <i class="bi bi-chat-dots-fill" id="vetbotIconOpen"></i>
        <i class="bi bi-x-lg d-none" id="vetbotIconClose"></i>
    </button>

    <div id="vetbotWindow" class="vetbot-window">
        <div class="vetbot-header">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-white text-dark rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; font-size: 1.2rem;">
                    🐾
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white">VetBot Asistente</h6>
                    <small class="text-white-50" style="font-size: 0.75rem;">
                        <i class="bi bi-circle-fill text-success" style="font-size: 0.55rem;"></i> En línea con Gemini IA
                    </small>
                </div>
            </div>
            <button type="button" class="btn btn-sm text-white-50 p-1" onclick="toggleVetBot()" aria-label="Cerrar chat">
                <i class="bi bi-x-lg fs-5 text-white"></i>
            </button>
        </div>

        <div class="vetbot-messages" id="vetbotMessages">
            <div class="vetbot-msg vetbot-msg-bot">
                <div class="fw-bold mb-1" style="font-size: 0.8rem; color: #7c3aed;">
                    <i class="bi bi-robot me-1"></i>VetBot
                </div>
                ¡Hola! 🐾 Soy <strong>VetBot</strong>, tu asistente virtual inteligente de VetWeb. ¿En qué te puedo orientar hoy con tu mascota?
                <div class="mt-2 pt-2 border-top">
                    <small class="text-muted d-block mb-1" style="font-size: 0.72rem;">Consultas sugeridas:</small>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="vetbot-chip" onclick="sendQuickPrompt('¿Cómo saco un turno para mi mascota?')">📅 Sacar turno</span>
                        <span class="vetbot-chip" onclick="sendQuickPrompt('¿Cómo realizo el pago por transferencia en el Pet Shop?')">💳 Pago Pet Shop</span>
                        <span class="vetbot-chip" onclick="sendQuickPrompt('¿Qué cuidados básicos necesita un cachorro?')">🐶 Cuidados cachorro</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="vetbot-footer">
            <form id="vetbotForm" onsubmit="handleVetBotSubmit(event)">
                <div class="input-group">
                    <input type="text" id="vetbotInput" class="form-control form-control-sm border-end-0" 
                           placeholder="Escribe tu consulta aquí..." autocomplete="off" />
                    <button type="submit" id="vetbotSendBtn" class="btn btn-primary btn-sm px-3" style="background-color: #7c3aed; border-color: #7c3aed;">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </form>
            <div class="text-center mt-1">
                <small class="text-muted" style="font-size: 0.68rem;">
                    Orientación asistida por IA. Ante emergencias acudí a la guardia veterinaria.
                </small>
            </div>
        </div>
    </div>

    <script>
        let vetbotHistory = [];
        let vetbotLoading = false;

        function toggleVetBot() {
            const win = document.getElementById('vetbotWindow');
            const openIcon = document.getElementById('vetbotIconOpen');
            const closeIcon = document.getElementById('vetbotIconClose');
            const callout = document.getElementById('vetbotCallout');

            if (win.style.display === 'flex') {
                win.style.display = 'none';
                openIcon.classList.remove('d-none');
                closeIcon.classList.add('d-none');
            } else {
                win.style.display = 'flex';
                openIcon.classList.add('d-none');
                closeIcon.classList.remove('d-none');
                if (callout) callout.style.opacity = '0';
                setTimeout(() => {
                    document.getElementById('vetbotInput').focus();
                    scrollVetBotBottom();
                }, 100);
            }
        }

        function sendQuickPrompt(promptText) {
            document.getElementById('vetbotInput').value = promptText;
            handleVetBotSubmit(new Event('submit'));
        }

        async function handleVetBotSubmit(e) {
            if (e) e.preventDefault();
            if (vetbotLoading) return;

            const input = document.getElementById('vetbotInput');
            const message = input.value.trim();
            if (!message) return;

            input.value = '';
            appendVetBotMessage('user', message);
            vetbotLoading = true;
            document.getElementById('vetbotSendBtn').disabled = true;

            const typingId = showVetBotTyping();

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: message,
                        history: vetbotHistory
                    })
                });

                removeVetBotTyping(typingId);

                if (!response.ok) {
                    appendVetBotMessage('bot', 'Lo siento, ocurrió un error de comunicación con el servidor.');
                    return;
                }

                const data = await response.json();
                const reply = data.reply || 'No obtuve respuesta.';
                appendVetBotMessage('bot', reply);

                vetbotHistory.push({ role: 'user', text: message });
                vetbotHistory.push({ role: 'model', text: reply });
                if (vetbotHistory.length > 12) vetbotHistory = vetbotHistory.slice(-12);
            } catch (err) {
                removeVetBotTyping(typingId);
                appendVetBotMessage('bot', 'No se pudo conectar con el servidor. Revisa tu conexión.');
            } finally {
                vetbotLoading = false;
                document.getElementById('vetbotSendBtn').disabled = false;
                input.focus();
            }
        }

        function appendVetBotMessage(role, text) {
            const container = document.getElementById('vetbotMessages');
            const msgDiv = document.createElement('div');
            msgDiv.className = `vetbot-msg ${role === 'user' ? 'vetbot-msg-user' : 'vetbot-msg-bot'}`;

            if (role === 'user') {
                msgDiv.textContent = text;
            } else {
                const titleSpan = document.createElement('div');
                titleSpan.className = 'fw-bold mb-1';
                titleSpan.style.fontSize = '0.8rem';
                titleSpan.style.color = '#7c3aed';
                titleSpan.innerHTML = '<i class="bi bi-robot me-1"></i>VetBot';
                msgDiv.appendChild(titleSpan);

                const bodySpan = document.createElement('div');
                bodySpan.innerHTML = formatMarkdownSimple(text);
                msgDiv.appendChild(bodySpan);
            }

            container.appendChild(msgDiv);
            scrollVetBotBottom();
        }

        function showVetBotTyping() {
            const container = document.getElementById('vetbotMessages');
            const typingDiv = document.createElement('div');
            const id = 'typing_' + Date.now();
            typingDiv.id = id;
            typingDiv.className = 'vetbot-msg vetbot-msg-bot vetbot-typing';
            typingDiv.innerHTML = '<span class="vetbot-dot"></span><span class="vetbot-dot"></span><span class="vetbot-dot"></span>';
            container.appendChild(typingDiv);
            scrollVetBotBottom();
            return id;
        }

        function removeVetBotTyping(id) {
            const elem = document.getElementById(id);
            if (elem) elem.remove();
        }

        function scrollVetBotBottom() {
            const container = document.getElementById('vetbotMessages');
            container.scrollTop = container.scrollHeight;
        }

        function formatMarkdownSimple(text) {
            let safe = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            safe = safe.replace(/\n/g, '<br/>');
            return safe;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
