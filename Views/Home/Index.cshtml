@{
    ViewData["Title"] = "Inicio - Pet Shop & Clínica";
    var turnos = ViewBag.ProximosTurnos as List<VetWeb.Models.Turno> ?? new List<VetWeb.Models.Turno>();
    var productos = ViewBag.ProductosDestacados as List<VetWeb.Models.Producto> ?? new List<VetWeb.Models.Producto>();
}

<!-- Banner Hero Principal -->
<div class="p-5 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                <i class="bi bi-star-fill me-1"></i> Sistema Integral Veterinario
            </span>
            <h1 class="display-5 fw-bold mb-2">Clínica Veterinaria & Pet Shop</h1>
            <p class="lead mb-4 text-light opacity-90">
                Gestiona la atención médica de tus pacientes, reserva turnos con especialistas y accede a nuestro catálogo de Pet Shop conectado en tiempo real a MariaDB.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Tienda" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-4 shadow-sm">
                    <i class="bi bi-cart3 me-1"></i> Ir a la Tienda Pet Shop
                </a>
                <a asp-controller="Turnos" asp-action="Reservar" class="btn btn-outline-light btn-lg fw-semibold px-4">
                    <i class="bi bi-calendar-plus me-1"></i> Sacar Turno Online
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-heart-pulse text-warning opacity-75" style="font-size: 8rem;"></i>
        </div>
    </div>
</div>

<!-- Métricas del Sistema -->
<div class="row g-3 mb-5">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 bg-white border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Productos en Tienda</span>
                    <h3 class="fw-bold mb-0 text-primary">@ViewBag.TotalProductos</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-3">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 bg-white border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Turnos Pendientes</span>
                    <h3 class="fw-bold mb-0 text-warning">@ViewBag.TotalTurnosPendientes</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 bg-white border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Pacientes Registrados</span>
                    <h3 class="fw-bold mb-0 text-success">@ViewBag.TotalMascotas</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                    <i class="bi bi-heart"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 bg-white border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Veterinarios</span>
                    <h3 class="fw-bold mb-0 text-info">@ViewBag.TotalVeterinarios</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                    <i class="bi bi-person-badge"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Próximos Turnos (Cruce JOIN) -->
    <div class="col-lg-7">
        <div class="card card-custom bg-white h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Próximos Turnos Agendados
                </h5>
                <a asp-controller="Turnos" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver Todos</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Fecha y Hora</th>
                                <th>Paciente / Dueño</th>
                                <th>Veterinario</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in turnos)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@t.FechaHora.ToString("dd/MM HH:mm") hs</td>
                                    <td>
                                        <div class="fw-bold text-dark">@t.Mascota?.Nombre</div>
                                        <small class="text-muted">Dueño: @t.Mascota?.Duenio?.NombreCompleto</small>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@t.Veterinario?.NombreCompleto</div>
                                        <small class="text-muted">@t.Motivo</small>
                                    </td>
                                    <td>
                                        <span class="badge @(t.Estado == "Pendiente" ? "bg-warning text-dark" : t.Estado == "En Consulta" ? "bg-info" : "bg-success") rounded-pill">
                                            @t.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Destacados de la Tienda Pet Shop -->
    <div class="col-lg-5">
        <div class="card card-custom bg-white h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-shop text-warning me-2"></i>Destacados Pet Shop
                </h5>
                <a asp-controller="Tienda" asp-action="Index" class="btn btn-outline-warning text-dark btn-sm">Ver Tienda</a>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var p in productos)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-light">
                            <div>
                                <h6 class="mb-1 fw-bold text-dark">@p.Nombre</h6>
                                <span class="badge bg-light text-secondary border me-1">@p.Categoria?.Nombre</span>
                                <small class="text-muted">Stock: @p.Stock un.</small>
                            </div>
                            <div class="text-end">
                                <span class="d-block fw-bold text-success fs-5">$@p.Precio.ToString("N0")</span>
                                <form asp-controller="Tienda" asp-action="Comprar" method="post" class="d-inline">
                                    <input type="hidden" name="idProducto" value="@p.IdProducto" />
                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill mt-1" @(p.Stock <= 0 ? "disabled" : "")>
                                        <i class="bi bi-bag-plus"></i> Comprar
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
