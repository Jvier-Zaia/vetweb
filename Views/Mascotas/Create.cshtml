@model VetWeb.Models.Mascota

@{
    ViewData["Title"] = "Registrar Paciente";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom bg-white">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-file-earmark-plus me-2"></i>Ficha de Nueva Mascota
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver al Directorio</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Mascota (*)</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Milo, Luna, Bobby" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdEspecie" class="form-label fw-semibold">Especie (*)</label>
                            <select asp-for="IdEspecie" class="form-select" asp-items="ViewBag.Especies"></select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdDuenio" class="form-label fw-semibold">Dueño / Responsable (*)</label>
                        <select asp-for="IdDuenio" class="form-select" asp-items="ViewBag.Duenios"></select>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Raza" class="form-label fw-semibold">Raza</label>
                            <input asp-for="Raza" class="form-control" placeholder="Ej: Golden, Mestizo" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Edad" class="form-label fw-semibold">Edad (años)</label>
                            <input asp-for="Edad" type="number" min="0" max="40" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Peso" class="form-label fw-semibold">Peso (kg)</label>
                            <input asp-for="Peso" type="number" step="0.1" class="form-control" placeholder="0.0" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Paciente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
